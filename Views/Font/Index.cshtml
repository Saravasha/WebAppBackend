@using WebAppBackend.Models
@model IEnumerable<Font>

@{
    ViewData["Title"] = "Fonts Index";
}

<section class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@ViewData["Title"]</h1>
        @{
            if (User.IsInRole("Admin"))
            {
                <a asp-controller="Font" asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-lg mr-1"></i>New Font
                </a>
            }
        }
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>Display Name</th>
                    <th>Style</th>
                    <th>Weight</th>
                    <th>Asset</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@Html.DisplayFor(m => item.Name)</td>
                        <td class="align-middle">@Html.DisplayFor(m => item.Style)</td>
                        <td class="align-middle">@Html.DisplayFor(m => item.Weight)</td>
                        <td class="align-middle">@Html.DisplayFor(m => item.Asset.Name)</td>

                
                        <td class="align-middle">
                            <div class="btn-group btn-group-sm d-flex justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-square mr-1"></i>Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash mr-1"></i>Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
