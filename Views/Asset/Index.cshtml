@using WebAppBackend.Models
@using WebAppBackend.ViewModels
@model AssetViewModel

@{
    ViewData["Title"] = "Asset Index";
}

<section class="container-fluid my-4">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <div class="d-flex flex-wrap justify-content-between align-items-end mb-3">
        <!-- Action Buttons -->
        <div class="btn-group mb-2">
            <a asp-action="Create" class="btn btn-outline-success"><i class="bi bi-plus-circle mr-1"></i>Add New Asset</a>
            <a asp-action="CreateMultipleAssets" class="btn btn-outline-primary"><i class="bi bi-collection mr-1"></i>Add Multiple Assets</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Asset" asp-action="Seed" class="btn btn-outline-danger"><i class="bi bi-bootstrap-reboot mr-1"></i>Seed Assets & Categories</a>
            }
        </div>

        <!-- Search & Filters -->
        <form asp-action="Index" method="get" class="card p-3 shadow-sm">
            <div class="form-row align-items-end">
                <div class="form-group mr-2">
                    <label for="searchString">Search</label>
                    <input type="text" id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Name, location..." />
                </div>
                <div class="form-group mr-2">
                    <label for="fromDate">From</label>
                    <input type="date" id="fromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="form-group mr-2">
                    <label for="toDate">To</label>
                    <input type="date" id="toDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="form-group d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary mr-2">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Assets Table -->
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle text-center">
            <thead class="thead-dark">
                <tr>
                    <th>Preview</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Author</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Categories</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model.Assets)
                {

                    var assetTypeLabel = asset.Type switch
                    {
                        AssetType.Document => "document",
                        AssetType.Text => "text",
                        _ => "asset"
                    };
                    <tr>
                        <td style="max-width: 160px; max-height: 100px;" class="text-center;">
                            @switch (asset.Type)
                            {
                                case AssetType.Image:
                                    <div style="cursor:pointer;"
                                         data-toggle="modal"
                                         data-target="#imageModal-@asset.Id">

                                        <img src="@Url.Content(asset.FileUrl)" alt="@asset.Name" class="img-fluid rounded border" style="max-height: 100px; object-fit: cover;" loading="lazy" />
                                    </div>
                                    break;
                                case AssetType.Video:
                                    if (!string.IsNullOrEmpty(asset.ThumbnailUrl))
                                    {
                                        <div class="position-relative video-thumb" style="cursor: pointer;" data-toggle="modal" data-target="#videoModal-@asset.Id">
                                            <img src="@Url.Content(asset.ThumbnailUrl)" alt="Video Thumbnail" class="img-fluid rounded" loading="lazy" />
                                            <i class="bi bi-play-circle-fill position-absolute" style="top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 2rem; color: white;"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <video controls preload="none" class="w-100" style="max-height: 100px;">
                                            <source src="@Url.Content(asset.FileUrl)" type="video/mp4" />
                                        </video>
                                    }
                                    break;
                                case AssetType.Audio:
                                    <div class="position-relative audio-thumb border border-dotted p-1" style="cursor: pointer;" data-toggle="modal" data-target="#audioModal-@asset.Id">
                                        <i class="bi bi-play-circle-fill play-icon"></i>
                                    </div>
                                    break;
                                case AssetType.Document:
                                    <div class="position-relative asset-name-container border border-dotted p-2 d-flex align-items-center gap-2"
                                         style="cursor:pointer;"
                                         data-toggle="modal"
                                         data-target="#@assetTypeLabel-Modal-@asset.Id">

                                        <span class="asset-icon flex-shrink-0">
                                            📄
                                        </span>

                                        <span class="asset-name text-truncate">
                                            &nbsp;@asset.Name
                                        </span>

                                    </div>

                                    break;
                                case AssetType.Text:
                                    <div class="position-relative asset-name-container border border-dotted p-2 d-flex align-items-center gap-2"
                                         style="cursor:pointer;"
                                         data-toggle="modal"
                                         data-target="#@assetTypeLabel-Modal-@asset.Id">

                                        <span class="asset-icon flex-shrink-0">
                                            📝
                                        </span>

                                        <span class="asset-name text-truncate">
                                            &nbsp;@asset.Name
                                        </span>

                                    </div>
                                    break;
                                case AssetType.Font:
                                    <div class="position-relative asset-name-container border border-dotted p-2 d-flex align-items-center gap-2" style="cursor:pointer;" data-toggle="modal" data-target="#fontModal-@asset.Id">
                                        <span class="asset-icon flex-shrink-0">
                                            🔤
                                        </span>

                                        <span class="asset-name text-truncate">
                                            &nbsp;@asset.Name
                                        </span>

                                    </div>
                                    break;

                                default:
                                    <em>No preview</em>
                                    break;
                            }
                        </td>
                        <td class="text-center align-middle">@asset.Name</td>
                        <td class="text-center align-middle">@asset.Description</td>
                        <td class="text-center align-middle">@asset.Author</td>
                        <td class="text-center align-middle">@asset.Location</td>
                        <td class="text-center align-middle">@asset.DateString</td>
                        <td class="text-center align-middle">@asset.Type</td>
                        <td class="text-center align-middle">
                            @foreach (var cat in asset.Categories)
                            {
                                <span class="badge badge-secondary">@cat.Name</span>

                                <br />
                            }
                        </td>
                        <td class="text-center align-middle">
                            <div class="btn-group btn-group-sm d-flex justify-content-center">
                                <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-outline-primary"><i class="bi bi-pencil-square mr-1"></i>Edit</a>
                                <a asp-action="Details" asp-route-id="@asset.Id" class="btn btn-outline-info"><i class="bi bi-info-circle mr-1"></i>Details</a>
                                <a asp-action="Delete" asp-route-id="@asset.Id" class="btn btn-outline-danger"><i class="bi bi-trash mr-1"></i>Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Image Modals -->
    @foreach (var imageAsset in Model.Assets.Where(a => a.Type == AssetType.Image))
    {
        <div class="modal fade"
             id="imageModal-@imageAsset.Id"
             tabindex="-1"
             role="dialog">

            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">@imageAsset.Name</h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>

                    <div class="modal-body text-center">

                        <img src="@Url.Content(imageAsset.FileUrl)"
                             class="img-fluid rounded"
                             alt="@imageAsset.Name" />

                    </div>

                </div>
            </div>
        </div>
    }
    <!-- Video Modals -->
    @foreach (var videoAsset in Model.Assets.Where(a => a.Type == AssetType.Video))
    {
        <div class="modal fade" id="videoModal-@videoAsset.Id" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-body p-0">
                        <video controls class="w-100" id="video-player-@videoAsset.Id" data-src="@Url.Action("Stream", "Asset", new { id = videoAsset.Id })">
                            <!-- Source will be added dynamically -->
                        </video>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Audio Modals -->
    @foreach (var audioAsset in Model.Assets.Where(a => a.Type == AssetType.Audio))
    {
        <div class="modal fade" id="audioModal-@audioAsset.Id" tabindex="-1" role="dialog" aria-labelledby="audioModalLabel-@audioAsset.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@audioAsset.Name</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <audio controls id="audio-player-@audioAsset.Id" data-src="@Url.Action("Stream", "Asset", new { id = audioAsset.Id })">
                            <!-- Source added via JS -->
                        </audio>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Text Modals -->
    @foreach (var asset in Model.Assets.Where(a =>
        a.Type == AssetType.Document || a.Type == AssetType.Text))
    {
        var assetTypeLabel = asset.Type == AssetType.Document ? "document" : "text";

        <div class="modal fade"
             id="@assetTypeLabel-Modal-@asset.Id"
             tabindex="-1"
             role="dialog"
             aria-labelledby="@assetTypeLabel-ModalLabel-@asset.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="@assetTypeLabel-ModalLabel-@asset.Id">
                            @asset.Name
                        </h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body text-center">

                        @if (asset.Type == AssetType.Text)
                        {
                            <pre class="text-content text-left"
                                 data-src="@Url.Content(asset.FileUrl)">Loading...
                            </pre>
                            <div class="mt-3">
                                <a href="@asset.FileUrl"
                                   target="_blank"
                                   class="btn btn-primary">
                                    Open Text File
                                </a>

                                <a href="@asset.FileUrl"
                                   download="@asset.Name"
                                   class="btn btn-secondary">
                                    Download
                                </a>
                            </div>
                        }
                        else if (asset.Type == AssetType.Document)
                        {

                            <iframe src="@asset.FileUrl"
                                    style="width:100%; height:600px; border:none;">
                            </iframe>

                            <div class="mt-3">
                                <a href="@asset.FileUrl"
                                   target="_blank"
                                   class="btn btn-primary">
                                    Open PDF
                                </a>

                                <a href="@asset.FileUrl"
                                   download="@asset.Name"
                                   class="btn btn-secondary">
                                    Download
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Font Modals -->
    @foreach (var fontAsset in Model.Assets.Where(a => a.Type == AssetType.Font))
    {
        <div class="modal fade"
             id="fontModal-@fontAsset.Id"
             tabindex="-1"
             role="dialog"
             aria-labelledby="fontModalLabel-@fontAsset.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="fontModalLabel-@fontAsset.Id">
                            @fontAsset.Name
                        </h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <small class="text-muted">
                                Preview
                            </small>

                            <h2 class="font-preview-@fontAsset.Id">
                                The quick brown fox jumps over the lazy dog
                            </h2>
                        </div>


                        <div class="border rounded p-3">
                            <p class="font-preview-@fontAsset.Id mb-2">
                                ABCDEFGHIJKLMNOPQRSTUVWXYZ
                            </p>

                            <p class="font-preview-@fontAsset.Id mb-0">
                                abcdefghijklmnopqrstuvwxyz
                            </p>

                            <p class="font-preview-@fontAsset.Id">
                                0123456789 !@@#$%^&*()
                            </p>
                        </div>


                        <div class="mt-3">
                            <a href="@Url.Content(fontAsset.FileUrl)"
                               download
                               class="btn btn-secondary">
                                Download Font
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    }

    <style>
        @foreach (var fontAsset in Model.Assets.Where(a => a.Type == AssetType.Font))
        {
            <text>
            @@font-face {
                font-family: 'AssetFont-@fontAsset.Id';
                src: url('@Url.Content(fontAsset.FileUrl)');
            }

            .font-preview-@fontAsset.Id {
                font-family: 'AssetFont-@fontAsset.Id';
            }
            </text>
        }
    </style>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.modal').on('shown.bs.modal', function() {
                const video = $(this).find('video')[0];
                if (video && video.children.length === 0) {
                    const sourceUrl = $(video).data('src');
                    const source = document.createElement('source');
                    source.src = sourceUrl;
                    source.type = 'video/mp4';
                    video.appendChild(source);
                    video.load();
                    video.play().catch(err => console.warn('Autoplay blocked', err));
                }

                const audio = $(this).find('audio')[0];
                if (audio && audio.children.length === 0) {
                    const sourceUrl = $(audio).data('src');
                    const source = document.createElement('source');
                    source.src = sourceUrl;
                    source.type = 'audio/mpeg';
                    audio.appendChild(source);
                    audio.load();
                    audio.play().catch(err => console.warn('Autoplay blocked', err));
                }

                const textContainer = $(this).find('.text-content')[0];

                if (textContainer && textContainer.dataset.loaded !== "true") {
                    const sourceUrl = $(textContainer).data('src');

                    fetch(sourceUrl)
                        .then(response => response.text())
                        .then(text => {
                            textContainer.textContent = text;
                            textContainer.dataset.loaded = "true";
                        })
                        .catch(() => {
                            textContainer.textContent = "Unable to load text file.";
                        });
                }

                $('.modal').on('hidden.bs.modal', function() {
                    const media = $(this).find('video, audio')[0];
                    if (media) {
                        media.pause();
                        media.currentTime = 0;
                        media.innerHTML = '';
                    }
                });
            });
        });
    </script>
}
