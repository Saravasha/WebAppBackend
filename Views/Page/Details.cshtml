@using WebAppBackend.Models
@model PageViewModel

@{
    ViewData["Title"] = "Page Details";
}

<section class="container my-4">
    <h1 class="mb-3">@ViewData["Title"]</h1>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Title)
                </dd>


                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Container)
                </dt>
                <dd class="col-sm-10 PageContainer">
                    @Html.Raw(Model.Container)
                </dd>


                <dt class="col-sm-2">
                    Relationships
                </dt>

                <dd class="col-sm-10">

                    @if (Model.Relationship != null)
                    {
                        @if (!string.IsNullOrEmpty(Model.Relationship.ChildLabel))
                        {
                            <div class="mb-2">
                                <strong>
                                    @Model.Relationship.ChildLabel
                                </strong>
                            </div>

                            @if (Model.Relationship.Children.Any())
                            {
                                foreach (var child in Model.Relationship.Children)
                                {
                                    <span class="badge badge-primary me-1">
                                        @child
                                    </span>
                                }
                            }
                            else
                            {
                                <p class="text-muted font-italic">
                                    No @Model.Relationship.ChildLabel available.
                                </p>
                            }
                        }


                        @if (!string.IsNullOrEmpty(Model.Relationship.GrandchildLabel))
                        {
                            <div class="mt-3 mb-2">
                                <strong>
                                    @Model.Relationship.GrandchildLabel
                                </strong>
                            </div>

                            @if (Model.Relationship.Grandchildren.Any())
                            {
                                foreach (var grandchild in Model.Relationship.Grandchildren)
                                {
                                    <span class="badge badge-secondary me-1">
                                        @grandchild
                                    </span>
                                }
                            }
                            else
                            {
                                <p class="text-muted font-italic">
                                    No @Model.Relationship.GrandchildLabel available.
                                </p>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-muted font-italic">
                            No relationships available.
                        </p>
                    }

                </dd>

            </dl>

        </div>
    </div>
        <!-- Submit -->
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi-arrow-clockwise mr-1"></i>Update</a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left mr-1"></i>Back to Pages
            </a>
        </div>
    </div>
</section>
